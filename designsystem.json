      },
      "spacing": {
        "unit": 4,
        "scales": {
          "xs": "4px",
          "sm": "8px",
          "md": "16px",
          "lg": "24px",
          "xl": "40px",
          "xxl": "64px"
        }
      },
      "borders": {
        "radius": {
          "sm": "4px",
          "md": "8px",
          "lg": "16px",
          "full": "9999px"
        },
        "width": {
          "thin": "1px",
          "thick": "2px"
        }
      },
      "shadows": {
        "soft": "0 4px 20px rgba(0, 0, 0, 0.04)",
        "medium": "0 8px 30px rgba(0, 0, 0, 0.08)"
      }
    }
  }
}