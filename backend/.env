#Node env mode can either be 'development' or 'production' don't add the quote
NODE_ENV=development
PORT=4000
SERVER_URL=http://localhost:4000

# FRONTEND URL (Development)
FRONTEND_DEV_URL=http://localhost:5173

# FRONTEND URL (Production)
FRONTEND_PROD_URL=https://fiscal_focus.netlify.app

# SQLite (Development)
DB_STORAGE=./src/database/fiscal_focus.db

# Use SQLite on Production (true or false)
USE_SQLite=true

# PostgreSQL (Production)
DB_HOST=localhost
DB_USER=root
DB_PASS=Password123@gmail.com
DB_PORT=5432
DB_NAME=fiscalfocus

# Bcrypt rounds
SALT=11

# Rate Limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# JWT
JWT_SECRET=fisfocus

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fawazrufai5@gmail.com
SMTP_PASSWORD=qajhzfeazlobuobm
