<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password | Fiscal Focus</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        }
        
        .gradient-text {
            background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .card-gradient {
            background: linear-gradient(145deg, #ffffff, #f8fafc);
            box-shadow: 8px 8px 16px #e2e8f0, -8px -8px 16px #ffffff;
        }
        
        .btn-danger {
            background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
            color: white;
            font-weight: 600;
            padding: 16px 40px;
            border-radius: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
            position: relative;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 38, 38, 0.3);
        }
        
        .btn-danger:after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: all 0.5s;
        }
        
        .btn-danger:hover:after {
            left: 100%;
        }
        
        .security-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 24px;
            border: 3px solid #fca5a5;
        }
        
        .warning-box {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border-left: 4px solid #f59e0b;
            border-radius: 10px;
            padding: 20px;
        }
        
        .url-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px;
            position: relative;
            transition: all 0.3s ease;
        }
        
        .url-box:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }
        
        .copy-btn {
            position: absolute;
            right: 12px;
            top: 12px;
            background: #e2e8f0;
            border: none;
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .copy-btn:hover {
            background: #cbd5e1;
        }
        
        .expiry-timer {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fee2e2;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            color: #dc2626;
        }
        
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #cbd5e1, transparent);
            margin: 24px 0;
        }
        
        .footer-box {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-2xl w-full">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="flex items-center justify-center mb-4">
                <div class="security-icon">
                    <i class="fas fa-key text-red-500 text-3xl"></i>
                </div>
            </div>
            <h1 class="text-3xl font-bold gradient-text mb-3">Reset Your Password</h1>
            <div class="expiry-timer mx-auto mb-4">
                <i class="fas fa-clock"></i>
                <span>Link expires in 1 hour</span>
            </div>
            <p class="text-gray-600 font-medium">Secure your Fiscal Focus account</p>
        </div>

        <!-- Main Card -->
        <div class="card-gradient rounded-2xl p-8 mb-10">
            <!-- Greeting -->
            <div class="mb-8">
                <div class="flex items-start mb-6">
                    <div class="bg-red-100 p-3 rounded-xl mr-4">
                        <i class="fas fa-user-shield text-red-600 text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 mb-2">Hello, <span class="text-red-600"><%= user.name %></span></h2>
                        <p class="text-gray-600">
                            We received a request to reset your Fiscal Focus account password. 
                            Click the button below to securely create a new password.
                        </p>
                    </div>
                </div>
                
                <div class="divider"></div>
            </div>

            <!-- CTA Section -->
            <div class="mb-10 text-center">
                <div class="mb-8">
                    <h3 class="text-lg font-bold text-gray-800 mb-4">Ready to Reset?</h3>
                    <p class="text-gray-600 mb-6 max-w-md mx-auto">
                        Click the button below to access the secure password reset page. 
                        You'll be guided through creating a new, strong password.
                    </p>
                    
                    <a href="<%= resetUrl %>" class="btn-danger">
                        <i class="fas fa-lock"></i>
                        <span>Reset My Password</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    
                    <p class="text-gray-500 text-sm mt-4">
                        <i class="fas fa-shield-alt mr-1"></i>
                        Secured with 256-bit encryption
                    </p>
                </div>
                
                <div class="divider"></div>
            </div>

            <!-- Alternative Method -->
            <div class="mb-8">
                <h4 class="font-bold text-gray-800 mb-3 flex items-center">
                    <i class="fas fa-link text-red-500 mr-2"></i>
                    Alternative Method
                </h4>
                <p class="text-gray-600 text-sm mb-4">
                    If the button doesn't work, copy and paste this URL into your browser:
                </p>
                
                <div class="url-box mb-4">
                    <div class="flex justify-between items-start">
                        <code class="text-sm break-all text-gray-700 pr-12"><%= resetUrl %></code>
                        <button class="copy-btn" onclick="copyToClipboard('<%= resetUrl %>')">
                            <i class="fas fa-copy mr-1"></i>Copy
                        </button>
                    </div>
                </div>
                
                <div id="copy-message" class="text-green-600 text-sm text-center hidden">
                    <i class="fas fa-check-circle mr-1"></i>URL copied to clipboard!
                </div>
            </div>

            <!-- Warning -->
            <div class="warning-box mb-10">
                <div class="flex items-start">
                    <i class="fas fa-exclamation-triangle text-yellow-600 text-xl mr-3 mt-1"></i>
                    <div>
                        <h4 class="font-bold text-yellow-800 mb-2">Important Security Notice</h4>
                        <p class="text-yellow-800 text-sm">
                            If you didn't request this password reset, please:
                            <ul class="mt-2 space-y-1">
                                <li>• Ignore this email - your account is still secure</li>
                                <li>• Review your account activity for suspicious behavior</li>
                                <li>• Contact our support team immediately if you notice anything unusual</li>
                            </ul>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="text-center">
                <div class="footer-box">
                    <h4 class="font-bold text-gray-800 mb-2">Need Help?</h4>
                    <p class="text-gray-600 text-sm mb-4">
                        If you're having trouble resetting your password or have any questions, 
                        our support team is here to help.
                    </p>
                    <a href="mailto:support@fiscalfocus.com" 
                       class="inline-flex items-center text-red-600 hover:text-red-700 font-medium">
                        <i class="fas fa-life-ring mr-2"></i>
                        Contact Support
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-gray-500 text-sm">
            <div class="flex justify-center space-x-4 mb-4">
                <span class="text-gray-400">
                    <i class="fas fa-lock mr-1"></i>Secure Transmission
                </span>
                <span class="text-gray-400">
                    <i class="fas fa-user-shield mr-1"></i>Privacy Protected
                </span>
            </div>
            
            <p class="mb-3">© <span class="font-semibold"><%= year %></span> Fiscal Focus. All rights reserved.</p>
            
            <p class="text-xs text-gray-400 max-w-md mx-auto leading-relaxed">
                This is an automated security message from Fiscal Focus. Please do not reply to this email.
                <br>
                <span class="font-mono text-gray-500 mt-2 inline-block">Keeping your finances secure since <%= year %></span>
            </p>
        </div>
    </div>

    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const message = document.getElementById('copy-message');
                message.classList.remove('hidden');
                setTimeout(() => {
                    message.classList.add('hidden');
                }, 3000);
            });
        }
    </script>
</body>
</html>