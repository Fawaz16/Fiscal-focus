<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password | Fiscal Focus</title>
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            color: #374151;
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* Container */
        .container {
            max-width: 640px;
            width: 100%;
            margin: 0 auto;
        }

        /* Typography */
        .gradient-text {
            background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 12px;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        h4 {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        p {
            margin-bottom: 16px;
            color: #6b7280;
        }

        .text-center {
            text-align: center;
        }

        .text-sm {
            font-size: 0.875rem;
        }

        .text-xs {
            font-size: 0.75rem;
        }

        .font-medium {
            font-weight: 500;
        }

        .font-semibold {
            font-weight: 600;
        }

        /* Header */
        .header {
            text-align: center;
            margin-bottom: 32px;
        }

        .security-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 24px;
            border: 3px solid #fca5a5;
        }

        .security-icon svg {
            width: 32px;
            height: 32px;
            fill: #ef4444;
        }

        .expiry-timer {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fee2e2;
            padding: 8px 20px;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 500;
            color: #dc2626;
            margin-bottom: 16px;
        }

        .expiry-timer svg {
            width: 14px;
            height: 14px;
            fill: #dc2626;
        }

        /* Card */
        .card {
            background: linear-gradient(145deg, #ffffff, #f8fafc);
            border-radius: 24px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 8px 8px 16px #e2e8f0, -8px -8px 16px #ffffff;
        }

        /* Greeting Section */
        .greeting {
            margin-bottom: 32px;
        }

        .greeting-header {
            display: flex;
            align-items: flex-start;
            margin-bottom: 24px;
        }

        .greeting-icon {
            background-color: #fee2e2;
            padding: 16px;
            border-radius: 16px;
            margin-right: 16px;
            flex-shrink: 0;
        }

        .greeting-icon svg {
            width: 20px;
            height: 20px;
            fill: #dc2626;
        }

        .highlight {
            color: #dc2626;
            font-weight: 600;
        }

        /* Divider */
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #cbd5e1, transparent);
            margin: 32px 0;
        }

        /* CTA Section */
        .cta-section {
            margin-bottom: 32px;
        }

        .cta-content {
            text-align: center;
            max-width: 500px;
            margin: 0 auto;
        }

        .btn-danger {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
            color: white;
            font-weight: 600;
            padding: 18px 40px;
            border-radius: 12px;
            text-decoration: none;
            margin: 24px 0;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
            position: relative;
            overflow: hidden;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 38, 38, 0.3);
        }

        .btn-danger::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: all 0.5s;
        }

        .btn-danger:hover::after {
            left: 100%;
        }

        .btn-danger svg {
            width: 16px;
            height: 16px;
            fill: white;
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            color: #6b7280;
            font-size: 0.875rem;
            margin-top: 8px;
        }

        .security-badge svg {
            width: 14px;
            height: 14px;
            fill: #059669;
            margin-right: 6px;
        }

        /* Alternative Method */
        .alternative-method {
            margin-bottom: 32px;
        }

        .method-header {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }

        .method-header svg {
            width: 16px;
            height: 16px;
            fill: #ef4444;
            margin-right: 8px;
        }

        .url-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 12px;
            position: relative;
            transition: all 0.3s ease;
        }

        .url-box:hover {
            background-color: #f1f5f9;
            border-color: #cbd5e1;
        }

        .url-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .url-text {
            font-family: 'Courier New', monospace;
            font-size: 0.875rem;
            color: #374151;
            word-break: break-all;
            padding-right: 80px;
        }

        .copy-btn {
            position: absolute;
            right: 12px;
            top: 12px;
            background: #e2e8f0;
            border: none;
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .copy-btn:hover {
            background: #cbd5e1;
        }

        .copy-btn svg {
            width: 12px;
            height: 12px;
            fill: #374151;
        }

        .copy-message {
            color: #059669;
            font-size: 0.875rem;
            text-align: center;
            margin-top: 8px;
            display: none;
        }

        .copy-message svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
            margin-right: 4px;
        }

        /* Warning Box */
        .warning-box {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border-left: 4px solid #f59e0b;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 40px;
        }

        .warning-content {
            display: flex;
            align-items: flex-start;
        }

        .warning-icon svg {
            width: 20px;
            height: 20px;
            fill: #d97706;
            margin-right: 16px;
            flex-shrink: 0;
            margin-top: 4px;
        }

        .warning-text {
            color: #92400e;
        }

        .warning-text ul {
            list-style-type: none;
            margin-top: 12px;
        }

        .warning-text li {
            margin-bottom: 6px;
            position: relative;
            padding-left: 20px;
        }

        .warning-text li::before {
            content: '•';
            position: absolute;
            left: 8px;
            color: #d97706;
            font-weight: bold;
        }

        /* Help Section */
        .help-section {
            margin-bottom: 32px;
        }

        .footer-box {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 24px;
            text-align: center;
        }

        .support-link {
            display: inline-flex;
            align-items: center;
            color: #dc2626;
            text-decoration: none;
            font-weight: 500;
            margin-top: 12px;
            transition: color 0.2s ease;
        }

        .support-link:hover {
            color: #b91c1c;
        }

        .support-link svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
            margin-right: 8px;
        }

        /* Footer */
        .footer {
            text-align: center;
            color: #6b7280;
            font-size: 0.875rem;
        }

        .footer-badges {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-bottom: 16px;
        }

        .footer-badge {
            display: flex;
            align-items: center;
            color: #9ca3af;
        }

        .footer-badge svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
            margin-right: 6px;
        }

        .footer-copyright {
            margin-bottom: 8px;
        }

        .footer-note {
            font-size: 0.75rem;
            color: #9ca3af;
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.5;
        }

        .footer-year {
            font-family: 'Courier New', monospace;
            color: #6b7280;
            margin-top: 12px;
            display: inline-block;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            body {
                padding: 16px;
            }
            
            .card {
                padding: 24px;
            }
            
            h1 {
                font-size: 1.75rem;
            }
            
            h2 {
                font-size: 1.25rem;
            }
            
            .btn-danger {
                width: 100%;
                padding: 16px 24px;
            }
            
            .footer-badges {
                flex-direction: column;
                gap: 12px;
            }
            
            .greeting-header {
                flex-direction: column;
            }
            
            .greeting-icon {
                margin-bottom: 16px;
                margin-right: 0;
            }
        }

        @media (max-width: 480px) {
            .card {
                padding: 20px;
            }
            
            .url-content {
                flex-direction: column;
            }
            
            .url-text {
                padding-right: 0;
                margin-bottom: 12px;
            }
            
            .copy-btn {
                position: static;
                align-self: flex-start;
            }
            
            .warning-content {
                flex-direction: column;
            }
            
            .warning-icon svg {
                margin-bottom: 12px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="security-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                </svg>
            </div>
            <h1 class="gradient-text">Reset Your Password</h1>
            <div class="expiry-timer">
                <svg viewBox="0 0 24 24">
                    <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                </svg>
                <span>Link expires in 1 hour</span>
            </div>
            <p class="font-medium">Secure your Fiscal Focus account</p>
        </div>

        <!-- Main Card -->
        <div class="card">
            <!-- Greeting -->
            <div class="greeting">
                <div class="greeting-header">
                    <div class="greeting-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                        </svg>
                    </div>
                    <div>
                        <h2>Hello, <span class="highlight"><%= user.name %></span></h2>
                        <p>
                            We received a request to reset your Fiscal Focus account password. 
                            Click the button below to securely create a new password.
                        </p>
                    </div>
                </div>
                
                <div class="divider"></div>
            </div>

            <!-- CTA Section -->
            <div class="cta-section">
                <div class="cta-content">
                    <h3>Ready to Reset?</h3>
                    <p>
                        Click the button below to access the secure password reset page. 
                        You'll be guided through creating a new, strong password.
                    </p>
                    
                    <a href="<%= resetUrl %>" class="btn-danger">
                        <svg viewBox="0 0 24 24">
                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                        </svg>
                        <span>Reset My Password</span>
                        <svg viewBox="0 0 24 24">
                            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                        </svg>
                    </a>
                    
                    <div class="security-badge">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                        </svg>
                        <span>Secured with 256-bit encryption</span>
                    </div>
                </div>
                
                <div class="divider"></div>
            </div>

            <!-- Alternative Method -->
            <div class="alternative-method">
                <div class="method-header">
                    <svg viewBox="0 0 24 24">
                        <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/>
                    </svg>
                    <h4>Alternative Method</h4>
                </div>
                <p class="text-sm">
                    If the button doesn't work, copy and paste this URL into your browser:
                </p>
                
                <div class="url-box">
                    <div class="url-content">
                        <code class="url-text"><%= resetUrl %></code>
                        <button class="copy-btn" onclick="copyToClipboard('<%= resetUrl %>')">
                            <svg viewBox="0 0 24 24">
                                <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                            </svg>
                            Copy
                        </button>
                    </div>
                </div>
                
                <div id="copy-message" class="copy-message">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    URL copied to clipboard!
                </div>
            </div>

            <!-- Warning -->
            <div class="warning-box">
                <div class="warning-content">
                    <div class="warning-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                        </svg>
                    </div>
                    <div class="warning-text">
                        <h4>Important Security Notice</h4>
                        <p>If you didn't request this password reset, please:</p>
                        <ul>
                            <li>Ignore this email - your account is still secure</li>
                            <li>Review your account activity for suspicious behavior</li>
                            <li>Contact our support team immediately if you notice anything unusual</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="help-section">
                <div class="footer-box">
                    <h4>Need Help?</h4>
                    <p class="text-sm">
                        If you're having trouble resetting your password or have any questions, 
                        our support team is here to help.
                    </p>
                    <a href="mailto:support@fiscalfocus.com" class="support-link">
                        <svg viewBox="0 0 24 24">
                            <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
                        </svg>
                        Contact Support
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-badges">
                <div class="footer-badge">
                    <svg viewBox="0 0 24 24">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                    </svg>
                    <span>Secure Transmission</span>
                </div>
                <div class="footer-badge">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                    </svg>
                    <span>Privacy Protected</span>
                </div>
            </div>
            
            <p class="footer-copyright">© <span class="font-semibold"><%= year %></span> Fiscal Focus. All rights reserved.</p>
            
            <p class="footer-note">
                This is an automated security message from Fiscal Focus. Please do not reply to this email.
                <br>
                <span class="footer-year">Keeping your finances secure since <%= year %></span>
            </p>
        </div>
    </div>

    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const message = document.getElementById('copy-message');
                message.style.display = 'block';
                setTimeout(() => {
                    message.style.display = 'none';
                }, 3000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        }
    </script>
</body>
</html>