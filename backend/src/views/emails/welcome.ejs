<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Fiscal Focus</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');


        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        }

        .gradient-text {
            background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-gradient {
            background: linear-gradient(145deg, #ffffff, #f8fafc);
            box-shadow: 8px 8px 16px #e2e8f0, -8px -8px 16px #ffffff;
        }

        .icon-circle {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin-right: 16px;
        }

        .feature-card {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }

        .feature-card:hover {
            transform: translateY(-4px);
            border-left-color: #3b82f6;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.1);
        }

        .step-number {
            font-family: 'Source Code Pro', monospace;
            font-weight: 600;
            color: #1e293b;
            background: #e0f2fe;
            border-radius: 6px;
            padding: 2px 8px;
            margin-right: 12px;
        }

        .btn-primary {
            background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            font-weight: 600;
            padding: 14px 32px;
            border-radius: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
            position: relative;
            overflow: hidden;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
        }

        .btn-primary:after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: all 0.5s;
        }

        .btn-primary:hover:after {
            left: 100%;
        }

        .accent-border {
            border: 1px solid;
            border-image: linear-gradient(90deg, #3b82f6, #8b5cf6) 1;
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #cbd5e1, transparent);
            margin: 24px 0;
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-2xl w-full">
        <!-- Header -->
        <div class="text-center mb-12">
            <div class="flex items-center justify-center mb-4">
                <div class="icon-circle">
                    <i class="fas fa-chart-line text-white text-xl"></i>
                </div>
                <h1 class="text-4xl font-bold gradient-text">Fiscal Focus</h1>
            </div>
            <p class="text-gray-600 font-medium">Your personal financial compass</p>

            <div class="mt-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-3">Welcome aboard, <span class="text-blue-600">
                        <%= user.name %>
                    </span>!</h2>
                <p class="text-gray-600 max-w-lg mx-auto">
                    We're thrilled to help you navigate your financial journey with clarity and confidence.
                </p>
            </div>
        </div>

        <!-- Main Card -->
        <div class="card-gradient rounded-2xl p-8 mb-10">
            <!-- Personalized greeting -->
            <div class="mb-10">
                <div class="flex items-start mb-6">
                    <div class="bg-blue-100 p-3 rounded-xl mr-4">
                        <i class="fas fa-user-check text-blue-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-800 mb-2">Complete Your Profile</h3>
                        <p class="text-gray-600 mb-4">Just a few quick steps to personalize your experience:</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
                            <div class="flex items-center bg-blue-50 p-3 rounded-lg">
                                <i class="fas fa-camera text-blue-500 mr-3"></i>
                                <span class="text-gray-700">Add profile photo</span>
                            </div>
                            <div class="flex items-center bg-blue-50 p-3 rounded-lg">
                                <i class="fas fa-birthday-cake text-blue-500 mr-3"></i>
                                <span class="text-gray-700">Set birth date</span>
                            </div>
                            <div class="flex items-center bg-blue-50 p-3 rounded-lg">
                                <i class="fas fa-phone text-blue-500 mr-3"></i>
                                <span class="text-gray-700">Add phone number</span>
                            </div>
                            <div class="flex items-center bg-blue-50 p-3 rounded-lg">
                                <i class="fas fa-shield-alt text-blue-500 mr-3"></i>
                                <span class="text-gray-700">Privacy settings</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>
            </div>

            <!-- Getting Started -->
            <div class="mb-10">
                <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
                    <i class="fas fa-rocket text-blue-500 mr-3"></i>
                    Let's Get Started
                </h3>

                <div class="space-y-5">
                    <div class="feature-card bg-white p-5 rounded-xl">
                        <div class="flex items-start">
                            <span class="step-number">01</span>
                            <div>
                                <h4 class="font-bold text-gray-800 mb-1">Set Your Monthly Budget</h4>
                                <p class="text-gray-600 text-sm">Define your spending limits in the Dashboard</p>
                            </div>
                        </div>
                    </div>

                    <div class="feature-card bg-white p-5 rounded-xl">
                        <div class="flex items-start">
                            <span class="step-number">02</span>
                            <div>
                                <h4 class="font-bold text-gray-800 mb-1">Create Spending Categories</h4>
                                <p class="text-gray-600 text-sm">Tailor categories to match your lifestyle</p>
                            </div>
                        </div>
                    </div>

                    <div class="feature-card bg-white p-5 rounded-xl">
                        <div class="flex items-start">
                            <span class="step-number">03</span>
                            <div>
                                <h4 class="font-bold text-gray-800 mb-1">Log Your First Transaction</h4>
                                <p class="text-gray-600 text-sm">Takes just 30 seconds to get started</p>
                            </div>
                        </div>
                    </div>

                    <div class="feature-card bg-white p-5 rounded-xl">
                        <div class="flex items-start">
                            <span class="step-number">04</span>
                            <div>
                                <h4 class="font-bold text-gray-800 mb-1">Check Your Insights</h4>
                                <p class="text-gray-600 text-sm">Review patterns and stay on track</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Features -->
            <div class="mb-10">
                <h3 class="text-xl font-bold text-gray-800 mb-6 text-center">Why You'll Love It</h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="text-center p-5 bg-gradient-to-b from-blue-50 to-white rounded-xl">
                        <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-100 rounded-full mb-4">
                            <i class="fas fa-mobile-alt text-blue-600 text-xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-800 mb-2">Always With You</h4>
                        <p class="text-gray-600 text-sm">Track expenses anywhere, anytime</p>
                    </div>

                    <div class="text-center p-5 bg-gradient-to-b from-purple-50 to-white rounded-xl">
                        <div class="inline-flex items-center justify-center w-14 h-14 bg-purple-100 rounded-full mb-4">
                            <i class="fas fa-bell text-purple-600 text-xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-800 mb-2">Smart Notifications</h4>
                        <p class="text-gray-600 text-sm">Alerts to keep spending in check</p>
                    </div>

                    <div class="text-center p-5 bg-gradient-to-b from-cyan-50 to-white rounded-xl">
                        <div class="inline-flex items-center justify-center w-14 h-14 bg-cyan-100 rounded-full mb-4">
                            <i class="fas fa-chart-pie text-cyan-600 text-xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-800 mb-2">Visual Insights</h4>
                        <p class="text-gray-600 text-sm">Clear understanding of your finances</p>
                    </div>
                </div>
            </div>

            <!-- CTA Button -->
            <div class="text-center pt-6">
                <a href="<%= process.env.FRONTEND_PROD_URL %>/dashboard" class="btn-primary inline-block">
                    <span>Launch Your Dashboard</span>
                    <i class="fas fa-arrow-right ml-2"></i>
                </a>
                <p class="text-gray-500 text-sm mt-4">Your financial journey starts with a single click</p>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-gray-500 text-sm">
            <div class="accent-border p-6 rounded-xl mb-6">
                <p class="mb-3 font-medium">Need assistance?</p>
                <a href="mailto:support@fiscalfocus.com" class="text-blue-600 hover:text-blue-800 font-medium">
                    <i class="fas fa-envelope mr-2"></i>support@fiscalfocus.com
                </a>
            </div>

            <p class="mb-3">© <span class="font-semibold">
                    <%= year %>
                </span> Fiscal Focus. All rights reserved.</p>

            <p class="text-xs text-gray-400 max-w-md mx-auto leading-relaxed">
                You're receiving this email because you signed up for Fiscal Focus. If this wasn't you, please disregard
                this message.
                <br>
                <span class="font-mono text-gray-500 mt-2 inline-block">Empowering financial decisions since <%= year %>
                </span>
            </p>
        </div>
    </div>
</body>

</html>